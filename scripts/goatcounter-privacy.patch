 	var enc = encodeURIComponent
 
+	// Orisod privacy patch: the only URL parameters that may be sent are the ones
+	// GoatCounter reads as a campaign or source. Everything else (such as the site
+	// search's ?search= words) is dropped before sending.
+	var ORISOD_ALLOWED_PARAMS = ['utm_campaign', 'campaign', 'utm_source', 'ref', 'src', 'source']
+	var orisod_query = function() {
+		var keep = [], parts = location.search.substr(1).split('&')
+		for (var i = 0; i < parts.length; i++) {
+			var name = parts[i].split('=')[0]
+			try { name = decodeURIComponent(name.replace(/\+/g, ' ')) } catch (err) { continue }
+			if (ORISOD_ALLOWED_PARAMS.indexOf(name) > -1)
+				keep.push(parts[i])
+		}
+		return keep.length ? '?' + keep.join('&') : ''
+	}
+	// Orisod privacy patch: a URL without its query string and fragment.
+	var orisod_strip_query = function(u) { return (u || '').split('#')[0].split('?')[0] }
+
